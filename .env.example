# ── DATABASE (dari Railway PostgreSQL plugin) ──────
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── JWT ────────────────────────────────────────────
JWT_SECRET=ganti_dengan_string_random_panjang_min32char

# ── AI PROVIDER (pilih salah satu) ─────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy_ISI_KEY_KAMU_DISINI
GEMINI_MODEL=gemini-1.5-flash

# Atau OpenAI:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxx
# OPENAI_MODEL=gpt-4o-mini

# ── APP ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://your-app.railway.app

# ── QUIZ ────────────────────────────────────────────
QUIZ_QUESTIONS_COUNT=20
QUIZ_TIME_SECONDS=30
QUIZ_STREAK_THRESHOLD=3
